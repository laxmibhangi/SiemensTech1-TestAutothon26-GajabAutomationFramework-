# Copy to .env and fill in. NEVER commit .env  (see .gitignore)

# ---------- Application under test ----------
BASE_URL=https://stg.gajab.com
DEFAULT_LANGUAGE=English

# ---------- Test account ----------
# Use ONLY an authorised test mobile number provided by the organisers.
TEST_MOBILE_NUMBER=
DEFAULT_OTP=123456
PINCODE=560025

# ---------- Browser ----------
BROWSER=chrome
HEADLESS=false
IMPLICIT_WAIT=0
EXPLICIT_WAIT=25

# ---------- Email step (deliverable #7 of the journey) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# ---------- Android (real device over adb) ----------
APPIUM_SERVER_URL=http://127.0.0.1:4723
ANDROID_UDID=
ANDROID_PLATFORM_VERSION=
ANDROID_APP_PACKAGE=com.gajab.buyerstore
ANDROID_APP_ACTIVITY=com.gajab.buyerstore.MainActivity
ANDROID_APP_PATH=../gajab-hackathon-sep4.apk
